{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskFlow",
  "version": "0.1.0",
  "identifier": "com.taskflow.desktop",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "set TAURI_BUILD=1 && npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "./dist-placeholder"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaskFlow",
        "url": "http://localhost:3000",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
